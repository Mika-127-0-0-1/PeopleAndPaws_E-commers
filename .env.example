# Clerk authentication (Clerk Dashboard -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# PostgreSQL / Prisma
# Pooled runtime connection, typically ending with ?pgbouncer=true for older providers.
POSTGRES_PRISMA_URL=
# Direct connection used by Prisma schema operations such as db push/migrate.
POSTGRES_URL_NON_POOLING=

# Public URL of the separate storefront application.
FRONTEND_STORE_URL=http://localhost:3001

# Shared by both applications. Generate a long random value and keep it secret.
ENCRYPTION_SECRET=

# Required by next-cloudinary's upload widget.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
